{
  "name": "@orb-club/modules",
  "version": "0.1.0",
  "type": "module",
  "sideEffects": false,
  "types": "./dist/index.d.ts",
  "files": [
    "dist",
    "README.md",
    "AGENTS.md",
    "llms.txt",
    "docs/getting-started.md",
    "docs/auth.md",
    "docs/configuration.md",
    "docs/errors.md"
  ],
  "scripts": {
    "build": "tsup",
    "check": "bun tsc --noEmit",
    "test": "vitest run",
    "test:types": "tsc -p tsconfig.type-tests.json --noEmit",
    "lint": "biome check .",
    "lint:fix": "biome check --write .",
    "format": "biome format --write .",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": [
      "biome check --write --no-errors-on-unmatched"
    ],
    "*.{json,md}": [
      "biome format --write --no-errors-on-unmatched"
    ]
  },
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./auth": {
      "types": "./dist/auth/index.d.ts",
      "import": "./dist/auth/index.js",
      "require": "./dist/auth/index.cjs"
    },
    "./auth/qr": {
      "types": "./dist/auth/qr/index.d.ts",
      "import": "./dist/auth/qr/index.js",
      "require": "./dist/auth/qr/index.cjs"
    },
    "./media": {
      "types": "./dist/media/index.d.ts",
      "import": "./dist/media/index.js",
      "require": "./dist/media/index.cjs"
    },
    "./upload/grove": {
      "types": "./dist/upload/grove/index.d.ts",
      "import": "./dist/upload/grove/index.js",
      "require": "./dist/upload/grove/index.cjs"
    },
    "./transport/backend": {
      "types": "./dist/transport/backend/index.d.ts",
      "import": "./dist/transport/backend/index.js",
      "require": "./dist/transport/backend/index.cjs"
    }
  },
  "devDependencies": {
    "@biomejs/biome": "^2.4.8",
    "@commitlint/cli": "^20.5.0",
    "@commitlint/config-conventional": "^20.5.0",
    "@types/node": "^25.5.0",
    "jsdom": "^26.1.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "tsup": "^8.5.0",
    "vitest": "^3.2.0",
    "typescript": "^5.5.0"
  }
}
